# ---------------------------------------------------------------
# Copy to `.env` (project root) for Docker, and to `server/.env` for running locally.
# Never commit the real .env file.
# ---------------------------------------------------------------

# --- Server ---
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/website-change-detector
CLIENT_URL=http://localhost:5173
SCREENSHOT_DIR=./screenshots
DEMO_URL=http://localhost:5000/demo
OPENAI_API_KEY=             # optional; enables best-effort AI change summaries

# --- Optional login (leave empty to disable) ---
AUTH_PASSWORD=
JWT_SECRET=change-me

# --- Email alerts (any SMTP provider, e.g. Gmail app password / Brevo / Mailtrap) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Telegram alerts: create a bot with @BotFather and paste the token ---
TELEGRAM_BOT_TOKEN=
# (Discord needs no server setup: each watch has its own webhook URL)

# --- Scheduler / politeness (defaults shown) ---
QUEUE_CONCURRENCY=2            # checks running at once
JOB_TIMEOUT_SECONDS=90         # hard limit for one check
NAV_TIMEOUT_SECONDS=30         # page load limit
MAX_RETRIES=2                  # retries for transient errors (exponential back-off)
MIN_DOMAIN_GAP_SECONDS=5       # minimum gap between requests to the same domain
DOMAIN_COOLDOWN_MINUTES=10     # pause on a domain after HTTP 429/503
PAGE_CACHE_TTL_SECONDS=120     # same URL within this window is fetched once, shared by all watches

# --- Noise / alert control ---
NOISY_AFTER_CHANGES=5          # page changing on N checks in a row => alerts paused
ALERT_COOLDOWN_MINUTES=30      # extra changes inside this window go to the daily digest
FAILURE_ALERT_AFTER=3          # failed checks in a row before an outage alert
MAX_SNAPSHOTS_PER_WATCH=50
DIGEST_CRON="0 9 * * *"        # when the daily digest is sent (server time)

# --- Local testing only ---
# ALLOW_PRIVATE_URLS=true      # allows watching localhost pages. Keep OFF in production (SSRF protection)
# PUPPETEER_EXECUTABLE_PATH=   # path to Chrome/Chromium if Puppeteer cannot download its own
